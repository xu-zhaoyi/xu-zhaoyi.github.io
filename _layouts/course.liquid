---
layout: default
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>

    {% if page.term or page.year %}
      <p class="post-meta">
        {% if page.term %}{{ page.term }}{% endif %}
        {% if page.year %} {{ page.year }}{% endif %}
      </p>
    {% endif %}
  </header>

  <div class="post-content">
    {% if page.description %}
      {% if page.description.first %}
        <ul>
          {% for item in page.description %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% else %}
        {{ page.description | markdownify }}
      {% endif %}
    {% endif %}

    {{ content }}
  </div>
</article>
