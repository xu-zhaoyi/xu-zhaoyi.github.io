---
layout: default
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>

    {% if page.term or page.year %}
      <p class="post-meta">
        {% if page.term %}{{ page.term }}{% endif %}
        {% if page.year %} {{ page.year }}{% endif %}
      </p>
    {% endif %}
  </header>

  <div class="post-content">
    {% if page.description %}
  {% if page.description.first %}
    <ul class="course-desc">
      {% for item in page.description %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <div class="course-desc">
      {{ page.description | markdownify }}
    </div>
  {% endif %}
{% endif %}


{% if course.description %}
  <div class="course-description">
    {% assign desc_json = course.description | jsonify %}
    {% if desc_json contains '[' %}
      <ul class="course-desc">
        {% for item in course.description %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% else %}
      {{ course.description | markdownify }}
    {% endif %}
  </div>
{% endif %}


    {{ content }}
  </div>
</article>
